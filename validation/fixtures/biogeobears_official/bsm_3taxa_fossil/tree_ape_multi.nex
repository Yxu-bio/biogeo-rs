#NEXUS
[Exported with R package ape; volatile timestamp removed for a deterministic fixture.]

BEGIN TAXA;
	DIMENSIONS NTAX = 3;
	TAXLABELS
		human
		chimp
		gorilla
	;
END;
BEGIN TREES;
	TRANSLATE
		1	human,
		2	chimp,
		3	gorilla
	;
	TREE * half_length = [&R] ((1:0.455,2:0.5):0.5,3:1);
	TREE * official = [&R] ((1:0.91,2:1):1,3:2);
END;
